{
  "name": "pedeefe-desktop",
  "productName": "Pedeefe",
  "desktopName": "Pedeefe",
  "version": "2.4.2",
  "private": true,
  "description": "Pedeefe de escritorio: caja de herramientas PDF local",
  "main": "electron/main.js",
  "author": "ach.dev",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "dev.ach.pedeefe",
    "productName": "Pedeefe",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "backend-dist/pedeefe-backend",
        "to": "backend"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "assets/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.productivity"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
